{
  "info": {
    "_postman_id": "fitness-tracker-api-collection",
    "name": "Fitness Tracker API",
    "description": "REST API collection for testing user management endpoints in Fitness Tracker application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/v1/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users"]
            },
            "description": "Retrieves all users with full details (ID, firstName, lastName, birthdate, email)"
          },
          "response": []
        },
        {
          "name": "Get Simple Users List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/v1/users/simple",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users", "simple"]
            },
            "description": "Retrieves all users with basic information only (firstName and lastName)"
          },
          "response": []
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/v1/users/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users", "1"]
            },
            "description": "Retrieves a specific user by their unique identifier"
          },
          "response": []
        },
        {
          "name": "Get User by Email",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/v1/users/email?email=john.doe@example.com",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users", "email"],
              "query": [
                {
                  "key": "email",
                  "value": "john.doe@example.com"
                }
              ]
            },
            "description": "Searches for users by email address. Returns only user ID and email address"
          },
          "response": []
        },
        {
          "name": "Get Users Older Than Date",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/v1/users/older/2000-01-01",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users", "older", "2000-01-01"]
            },
            "description": "Retrieves all users who are older than the specified date (born before this date)"
          },
          "response": []
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"birthdate\": \"1990-05-15\",\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/v1/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users"]
            },
            "description": "Creates a new user in the system. Returns HTTP 201 Created"
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"birthdate\": \"1991-03-20\",\n  \"email\": \"jane.smith@example.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/v1/users/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users", "1"]
            },
            "description": "Updates an existing user with new information"
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/v1/users/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["v1", "users", "1"]
            },
            "description": "Deletes a user from the system. Returns HTTP 204 No Content"
          },
          "response": []
        }
      ]
    }
  ]
}
